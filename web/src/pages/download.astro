---
import BaseLayout from '../layouts/BaseLayout.astro';
import DitherField from '../components/DitherField.astro';
import DownloadStart from '../components/DownloadStart.svelte';
import SetupIllustration from '../components/SetupIllustration.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
---
<BaseLayout title="Download & setup | Kaji" description="Get Kaji for Windows and find your way through installation.">
  <section class="download-page" aria-labelledby="download-title">
    <DitherField side="right" anchor="center" eager />
    <div class="download-content">
      <div class:list={['download-intro', { 'has-installer': site.installer }]}>
        <h1 id="download-title">
          {site.installer && <span class="headline-line">Thanks for downloading!</span>}
          <span class="headline-line">just a few <span class="accent">steps left.</span></span>
        </h1>
        <div class="download-action">
          {site.installer ? <DownloadStart url={site.installer} client:load /> : <a class="release-link" href={site.releases}>View Windows releases <Icon name="external" size={17} /></a>}
        </div>
        <div class="download-help"><span>Made for Windows.</span><span class="help-divider" aria-hidden="true"></span><a href={site.github}>Need help? Visit GitHub <Icon name="external" size={15} /></a></div>
        <div class="motion-control"><button type="button" class="setup-pause" hidden>Pause animation</button></div>
      </div>
      <ol class="installation" id="installation" aria-label="Installation guide">
        <li>
          <div class="step-card step-blue">
            <SetupIllustration step={1} />
            <div class="step-info"><span class="step-number" aria-hidden="true">1</span>
            <p class="step-caption">Open the <strong>Kaji installer</strong> from your Downloads folder.</p>
            </div>
          </div>
        </li>
        <li>
          <div class="step-card step-amber">
            <SetupIllustration step={2} />
            <div class="step-info"><span class="step-number" aria-hidden="true">2</span>
            <p class="step-caption">Click <strong>More info</strong>, then <strong>Run anyway</strong>.</p>
            </div>
          </div>
        </li>
        <li>
          <div class="step-card step-mint">
            <SetupIllustration step={3} />
            <div class="step-info"><span class="step-number" aria-hidden="true">3</span>
            <p class="step-caption">Let setup finish,<br />then open <strong>Kaji.</strong></p>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>
</BaseLayout>
<script>
  import '../lib/setup-motion';
</script>
<style>
  .download-page { position: relative; isolation: isolate; overflow: clip; padding: 92px 0 96px; background: white; }
  .download-content { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1fr); gap: clamp(48px, 6vw, 100px); align-items: start; width: min(1232px, calc(100% - var(--gutter) * 2)); margin-inline: auto; }
  .download-intro { position: sticky; top: 48px; min-width: 0; padding-top: 12px; }
  h1 { max-width: 12ch; margin: 0; font-size: clamp(46px, 4.4vw, 68px); font-weight: 750; line-height: 1.04; letter-spacing: -.055em; }
  .headline-line { display: block; }
  .download-action { margin-top: 25px; color: var(--muted); }
  .release-link { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; font-size: 17px; font-weight: 400; }
  .download-action :global(p) { font-size: 20px; line-height: 1.5; }
  .download-action :global(a) { display: inline-flex; align-items: center; min-height: 44px; }
  .installation { display: grid; gap: 18px; min-width: 0; margin: 0; padding: 0; list-style: none; scroll-margin-top: 40px; }
  .installation li { min-width: 0; }
  .step-number { position: relative; display: grid; place-items: center; width: 36px; height: 36px; margin-bottom: 18px; border-radius: 50%; background: var(--blue); color: white; font-family: var(--font-display); font-size: 19px; font-weight: 650; line-height: 1; }
  .step-number::after { position: absolute; inset: -4px; border: 1px solid var(--blue); border-radius: 50%; opacity: 0; pointer-events: none; content: ''; }
  @media (prefers-reduced-motion: no-preference) {
    .installation[data-demo-playing] .step-number::after { animation: step-indicator 14s infinite; }
    .installation[data-demo-playing] li:nth-child(2) .step-number::after { animation-delay: 3s; }
    .installation[data-demo-playing] li:nth-child(3) .step-number::after { animation-delay: 6.4s; }
    .installation[data-demo-paused] .step-number::after { animation-play-state: paused; }
  }
  @keyframes step-indicator { 0%, 21%, 100% { opacity: 0; transform: scale(.96); } 3%, 18% { opacity: .55; transform: scale(1); } }
  .step-card { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: center; min-height: 270px; border: 1px solid transparent; border-radius: 18px; }
  .step-card :global(.setup-art) { height: 250px; padding: 16px; }
  .step-info { min-width: 0; padding: 24px 24px 24px 4px; }
  .step-blue { border-color: #d8e5fb; background: #edf3ff; }
  .step-amber { border-color: #f9edce; background: #fff9eb; }
  .step-mint { border-color: #d1f1e7; background: #e8faf4; }
  .step-caption { max-width: 22ch; margin: 0; color: var(--muted); font-size: 17px; font-weight: 400; line-height: 1.45; letter-spacing: -.025em; }
  .step-caption strong { color: var(--ink); font-weight: 600; }
  .download-help { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 20px; max-width: 100%; margin-top: 42px; color: var(--muted); font-size: 14px; }
  .download-help a { display: inline-flex; align-items: center; gap: 5px; min-height: 44px; }
  .motion-control { min-height: 44px; }
  .setup-pause { min-height: 44px; padding: 0; border: 0; background: transparent; color: var(--muted); font-size: 13px; text-decoration: underline; text-underline-offset: 4px; }
  .setup-pause:hover { color: var(--blue); }
  .help-divider { display: block; width: 1px; height: 17px; background: var(--border); }

  @media (min-width: 768px) and (max-width: 1100px) {
    .download-page { padding-top: 72px; }
    .download-content { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 36px; }
    .step-card { grid-template-columns: 1fr; }
    .step-card :global(.setup-art) { height: 240px; }
    .step-info { display: flex; align-items: center; gap: 16px; padding: 0 20px 20px; }
    .step-number { flex: 0 0 36px; margin: 0; }
  }

  @media (max-width: 767px) {
    .download-page { padding: 48px 0 64px; }
    .download-content { grid-template-columns: 1fr; gap: 36px; width: min(440px, calc(100% - 40px)); }
    .download-intro { position: relative; top: auto; padding: 0; }
    h1 { max-width: 14ch; font-size: clamp(36px, 8vw, 46px); line-height: 1.07; letter-spacing: -.045em; }
    .has-installer h1 { font-size: clamp(26px, 5.8vw, 42px); }
    .download-action { margin-top: 18px; }
    .release-link { font-size: 15px; }
    .download-action :global(p) { font-size: 16px; }
    .installation { gap: 16px; }
    .step-card { grid-template-columns: 1fr; min-height: 0; }
    .step-card :global(.setup-art) { height: 250px; padding: 18px 18px 0; }
    .step-info { display: flex; align-items: center; gap: 16px; padding: 16px 20px 24px; }
    .step-number { flex: 0 0 36px; margin: 0; }
    .step-caption { max-width: 27ch; font-size: 17px; }
    .download-help { margin-top: 24px; font-size: 13px; }
  }
</style>
