{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaji",
  "version": "0.1.2",
  "identifier": "id.kaji.engine",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "bun run build:resources" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "capabilities": ["sensor", "gui", "audio", "overlay"]
    }
  },
  "bundle": { "active": false },
  "plugins": { "updater": {
    "requireSignedVersion": true,
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3MUE2MkJCMjg5MzExRDUKUldUVkVaTW91MklhMXd2TCtkNVdZMW5sWUZVUWZ2RTZMRUFZNUU2Q2w2T0FOb050M01uUXlQNEoK",
    "endpoints": ["https://kaji.henix.my.id/updates/latest.json"],
    "windows": { "installMode": "quiet" }
  } }
}
