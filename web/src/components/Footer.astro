---
import logo from '../../../logo/kaji-logo.svg?url';
import { site } from '../config/site';
---
<footer class="footer">
  <div class="container footer-inner">
    <a class="footer-brand" href="/" aria-label="Kaji home"><img src={logo} alt="Kaji" width="103" height="40" loading="lazy" /></a>
    <span class="footer-note">A little guidance. More independence.</span>
    <nav aria-label="Footer navigation">
      <a href={site.github}>GitHub</a>
      <a href="/download#installation">Installation guide</a>
      <a href="/#how-it-works">How it works</a>
    </nav>
  </div>
</footer>
<style>
  .footer { background: var(--surface); border-top: 1px solid #eaf0fa; }
  .footer-inner { min-height: 128px; display: flex; align-items: center; gap: 30px; }
  .footer-brand { display: flex; align-items: center; min-height: 44px; flex-shrink: 0; }
  img { display: block; width: 103px; height: auto; }
  .footer-note { color: var(--muted); font-size: 12px; }
  nav { margin-left: auto; display: flex; gap: 28px; flex-wrap: wrap; }
  nav a { font-size: 13px; color: var(--muted); display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  nav a:hover { color: var(--blue); text-decoration: underline; }
  @media (max-width: 900px) { .footer-note { display: none; } }
  @media (max-width: 600px) { .footer-inner { padding-block: 28px; align-items: flex-start; gap: 18px; flex-direction: column; } nav { margin-left: 0; gap: 8px 24px; } }
</style>
