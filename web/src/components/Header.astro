---
import logo from '../../../logo/kaji-logo.svg?url';
import { site } from '../config/site';
const downloading = Astro.url.pathname.replace(/\/$/, '') === '/download';
---
<header class="header container">
  <a class="brand" href="/" aria-label="Kaji home"><img src={logo} alt="Kaji" width="123" height="48" fetchpriority="high" /></a>
  <nav aria-label="Main navigation">
    <a class="how-link" href="/#how-it-works">How it works</a>
    <a href={site.github}>GitHub</a>
    <a class="nav-download" href="/download" aria-current={downloading ? 'page' : undefined}>Download</a>
  </nav>
</header>
<style>
  .header { display: flex; align-items: center; justify-content: space-between; min-height: 92px; gap: 24px; position: relative; z-index: 3; }
  .brand { display: flex; align-items: center; flex-shrink: 0; min-height: 48px; }
  .brand img { width: 111px; height: auto; display: block; }
  nav { display: flex; align-items: center; gap: 36px; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-size: 14px; font-weight: 500; color: var(--muted); }
  nav a:hover { color: var(--blue); text-decoration: underline; text-underline-offset: 5px; }
  nav .nav-download { color: white; background: var(--blue); border-radius: 9px; padding: 10px 22px; }
  nav .nav-download:hover { background: #062568; text-decoration: none; }
  @media (max-width: 600px) { .header { min-height: 78px; gap: 12px; } .brand img { width: 94px; } nav { gap: 20px; } nav a { font-size: 13px; } nav .nav-download { padding-inline: 14px; } nav .how-link { display: none; } }
</style>
