---
import kajiLogo from '../../../logo/kaji-logo.svg?url';
import checkSvg from 'remixicon/icons/System/check-line.svg?raw';
import pauseSvg from 'remixicon/icons/Media/pause-fill.svg?raw';
import cursorSvg from 'remixicon/icons/Development/cursor-fill.svg?raw';
import folderSvg from 'remixicon/icons/Document/folder-open-line.svg?raw';
import settingsSvg from 'remixicon/icons/System/settings-3-line.svg?raw';
import boldSvg from 'remixicon/icons/Editor/bold.svg?raw';
import italicSvg from 'remixicon/icons/Editor/italic.svg?raw';
import underlineSvg from 'remixicon/icons/Editor/underline.svg?raw';
import alignLeftSvg from 'remixicon/icons/Editor/align-left.svg?raw';
import alignCenterSvg from 'remixicon/icons/Editor/align-center.svg?raw';
import wordSvg from 'remixicon/icons/Document/file-word-fill.svg?raw';
interface Props { kind: 'guide' | 'head' | 'control' }
const { kind } = Astro.props;
const descriptions = {
  guide: 'Step-by-step guidance highlights the Align Center control in a document editor.',
  head: 'Head control window with an Open target, a Kaji cursor inside a pink dwell timer, Open, Click and Settings controls, and a plain Head tracking active label.',
  control: 'Guide and Assist modes, a request to approve an action, and a prominent Pause Kaji control.',
};
---
<div class:list={['product-demo', kind]} role="img" aria-label={descriptions[kind]}>
  <div aria-hidden="true">
    <div class:list={['window-bar', { 'control-bar': kind === 'control' }]}>
      {kind === 'control' ? <img class="kaji-logo" src={kajiLogo} alt="" width="82" height="32" />
        : kind === 'guide' ? <span class="window-title"><span class="document-icon icon" set:html={wordSvg} /><span class="app-name">Document</span></span>
        : <span class="window-title">Head control</span>}
      <span class="window-controls"><svg viewBox="0 0 68 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 9h10M29 4h9v9h-9zM55 4l9 9m0-9-9 9" /></svg></span>
    </div>
    {kind === 'guide' ? <>
      <div class="editor-menu"><span>File</span><span class="current-menu">Home</span><span>Insert</span><span>Draw</span><span>Layout</span><span class="wide-menu">References</span><span class="wide-menu">View</span></div>
      <div class="editor-ribbon">
        <div class="format-tools">
          <div class="font-readout"><span>Calibri (Body) <span class="font-caret">⌄</span></span><span class="font-size">11</span></div>
          <div class="text-tools"><span class="icon" set:html={boldSvg} /><span class="icon" set:html={italicSvg} /><span class="icon" set:html={underlineSvg} /><span class="font-color">A</span></div>
        </div>
        <div class="alignment-controls">
          <span class="control-shape align-left"><span class="icon" set:html={alignLeftSvg} /></span>
          <div class="alignment-target">
            <span class="control-shape align-center"><span class="icon" set:html={alignCenterSvg} /><span>Align Center</span></span>
            <span class="guide-callout">Click here next</span>
          </div>
        </div>
      </div>
      <div class="editor-canvas">
        <div class="document-page"><p class="document-heading">A little more freedom.</p><p>A clearer path through everyday tasks.</p><p>One step at a time, at your own pace.</p><span class="document-rule"></span></div>
      </div>
      <div class="guide-footer"><span class="step-marker">1</span><div class="step-copy"><strong>Center your paragraph</strong><span>Step 1 of 2 · Choose the highlighted control.</span></div></div>
    </> : kind === 'head' ? <>
      <div class="head-body">
        <div class="head-stage">
          <div class="dwell-target"><span class="target-icon icon" set:html={folderSvg} /><span>Open</span></div>
          <div class="dwell-visual">
            <svg class="dwell-ring" viewBox="0 0 200 200" fill="none"><circle class="ring-track" cx="100" cy="100" r="86" stroke-width="7" /><circle class="ring-progress" cx="100" cy="100" r="86" stroke-width="7" pathLength="100" stroke-dasharray="100" stroke-dashoffset="27" transform="rotate(-90 100 100)" /></svg>
            <img class="dwell-cursor" src="/art/cursor.png" alt="" width="150" height="165" loading="lazy" />
          </div>
          <span class="tracking-chip">Head tracking active</span>
        </div>
        <div class="head-tools">
          <span class="head-tool"><span class="icon" set:html={folderSvg} /><span>Open</span></span>
          <span class="head-tool selected-tool"><span class="icon" set:html={cursorSvg} /><span>Click</span></span>
          <span class="head-tool"><span class="icon" set:html={settingsSvg} /><span>Settings</span></span>
        </div>
      </div>
      <div class="head-footer">
        <div class="dwell-instruction"><strong>Hover on target for 0.9 seconds.</strong><span>Hold steady to click.</span></div>
        <div class="head-actions"><span>Pause</span><span>Reset</span></div>
      </div>
    </> : <>
      <div class="control-body">
        <div class="mode-choices">
          <div class="mode-choice"><span class="mode-symbol icon" set:html={cursorSvg} /><span class="mode-title">Guide<span class="selection-mark"></span></span><span class="mode-description">Show the next step</span></div>
          <div class="mode-choice selected"><span class="mode-symbol icon" set:html={checkSvg} /><span class="mode-title">Assist<span class="selection-mark"></span></span><span class="mode-description">Ask before acting</span></div>
        </div>
        <div class="permission-panel">
          <div class="permission-copy"><strong>Allow this action?</strong><span>Align the paragraph below to the center.</span></div>
          <p class="permission-preview">A little more freedom.</p>
          <div class="permission-actions"><span class="control-shape quiet-control">Cancel</span><span class="control-shape primary-control">Approve</span></div>
        </div>
        <div class="pause-control"><span class="icon" set:html={pauseSvg} /><span>Pause Kaji<small>Stops all actions immediately.</small></span></div>
      </div>
    </>}
  </div>
</div>
<style>
  .product-demo { container-type: inline-size; width: 100%; min-width: 0; border: 1px solid var(--border); border-radius: 18px; background: white; box-shadow: 0 12px 38px -16px rgb(9 49 141 / 21%); color: var(--ink); font-family: var(--font-body); font-size: 14px; line-height: 1.45; text-align: left; }
  p { margin: 0; }
  .icon { display: inline-flex; flex: 0 0 auto; width: 22px; height: 22px; }
  .icon :global(svg) { display: block; width: 100%; height: 100%; fill: currentColor; }
  .window-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 49px; padding: 12px 20px; border-radius: 17px 17px 0 0; background: var(--surface); }
  .window-title { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 500; }
  .app-name { color: var(--muted); }
  .document-icon { width: 23px; height: 23px; color: var(--blue); }
  .window-controls { flex: 0 0 68px; color: var(--muted); }
  .window-controls svg { display: block; width: 68px; height: 16px; }
  .editor-menu { display: flex; gap: clamp(12px, 3.6cqw, 27px); padding: 0 20px; height: 38px; background: var(--surface); color: var(--muted); font-size: 12px; }
  .editor-menu span { padding-bottom: 7px; }
  .current-menu { border-bottom: 2px solid var(--blue); color: var(--blue); font-weight: 600; }
  .editor-ribbon { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 18px 24px; border-block: 1px solid #e4e9f2; background: var(--surface); }
  .format-tools { display: grid; gap: 14px; min-width: 0; }
  .font-readout { display: flex; align-items: center; gap: 7px; color: var(--ink); font-size: 12px; }
  .font-readout>span { display: flex; justify-content: space-between; gap: 12px; padding: 6px 9px; border: 1px solid #e2e7f1; background: white; border-radius: 5px; white-space: nowrap; }
  .font-caret { color: var(--muted); }
  .font-readout .font-size { padding-inline: 10px; color: var(--muted); }
  .text-tools { display: flex; align-items: center; gap: 16px; }
  .text-tools .icon { width: 19px; height: 19px; }
  .font-color { font-size: 20px; line-height: 1; border-bottom: 3px solid var(--pink); }
  .control-shape { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; border: 1px solid transparent; border-radius: 9px; font-weight: 600; line-height: 1.25; }
  .alignment-controls { display: flex; align-items: center; gap: 8px; }
  .align-left { color: var(--muted); }
  .alignment-target { position: relative; }
  .align-center { flex-direction: column; gap: 8px; min-width: 100px; min-height: 78px; padding: 10px; border: 2px solid var(--pink-display); background: white; color: var(--blue); box-shadow: 0 0 0 3px #fd91cc22; font-size: 11px; }
  .align-center .icon { width: 29px; height: 29px; }
  .guide-callout { position: absolute; top: calc(100% + 12px); right: -8px; padding: 9px 14px; border-radius: 7px; background: var(--blue); color: white; font-size: 13px; font-weight: 500; white-space: nowrap; box-shadow: 0 5px 12px #09318d15; }
  .guide-callout::before { position: absolute; right: 38px; bottom: 100%; width: 9px; height: 9px; background: inherit; content: ''; transform: translateY(4px) rotate(45deg); }
  .editor-canvas { padding: 32px 32px 0; background: #edf2fa; overflow: hidden; }
  .document-page { min-height: 153px; padding: 22px 25px; border: 1px solid #e7ecf5; border-bottom: 0; border-radius: 7px 7px 0 0; background: white; font-size: 13px; color: var(--muted); }
  .document-heading { margin-bottom: 8px; color: var(--ink); font-family: var(--font-display); font-size: 19px; font-weight: 650; letter-spacing: -.4px; }
  .document-rule { display: inline-block; height: 6px; border-radius: 3px; width: 48%; background: #e0e7f1; margin-top: 14px; }
  .guide-footer { display: flex; align-items: center; gap: 10px; min-height: 59px; padding: 7px 16px; border-top: 1px solid #e4e9f2; }
  .step-marker { display: grid; flex: 0 0 26px; place-items: center; width: 26px; height: 26px; border: 1px solid var(--blue); border-radius: 50%; color: var(--blue); font-weight: 600; }
  .step-copy strong, .step-copy span { display: block; }
  .step-copy strong { font-size: 13px; }
  .step-copy span { margin-top: 3px; font-size: 11px; color: var(--muted); }
  .head { transform: rotate(-1.5deg); }
  .head .window-title { font-size: 14px; font-weight: 600; }
  .head-body { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: 22px; padding: 18px 20px; }
  .head-stage { position: relative; min-width: 0; min-height: 252px; border-radius: 15px; background: #f5f8fd; }
  .tracking-chip { position: absolute; left: 12px; bottom: 12px; display: inline-flex; padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: white; color: var(--blue); font-size: 10px; line-height: 1.4; }
  .dwell-visual { position: absolute; z-index: 1; left: 40%; top: 38%; width: 47%; aspect-ratio: 1; }
  .dwell-ring { display: block; width: 100%; height: 100%; }
  .ring-track { stroke: #d4dce9; }
  .ring-progress { stroke: var(--pink-display); stroke-linecap: round; }
  .dwell-cursor { position: absolute; width: 62%; height: auto; left: 24%; top: 17%; image-rendering: pixelated; transform: rotate(-6deg); }
  .dwell-target { position: absolute; top: 27%; left: 14%; display: flex; align-items: center; justify-content: center; gap: 12px; width: 62%; min-height: 66px; padding: 14px; border: 1px solid var(--pink); border-radius: 10px; background: #fff3fa; color: var(--blue); font-size: 21px; font-weight: 600; }
  .target-icon { width: 25px; height: 25px; }
  .head-tools { display: grid; align-content: center; gap: 14px; }
  .head-tool { display: flex; align-items: center; gap: 10px; min-height: 59px; padding: 12px 14px; border: 1px solid #e4eaf4; border-radius: 10px; color: var(--blue); font-size: 13px; font-weight: 500; }
  .head-tool .icon { width: 20px; height: 20px; }
  .selected-tool { border-color: var(--pink-display); background: #fff3fa; }
  .head-footer { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 16px 20px; border-top: 1px solid #e4eaf4; }
  .dwell-instruction strong, .dwell-instruction>span { display: block; }
  .dwell-instruction strong { font-size: 11px; font-weight: 600; }
  .dwell-instruction>span { margin-top: 4px; color: var(--muted); font-size: 10px; }
  .head-actions { display: flex; gap: 24px; color: var(--blue); font-size: 11px; font-weight: 600; }
  .control { max-width: 560px; margin-inline: auto; }
  .control-bar { min-height: 66px; padding-inline: 25px; background: white; }
  .kaji-logo { display: block; width: 82px; height: 32px; object-fit: contain; }
  .control-body { display: grid; gap: 18px; padding: 4px 25px 26px; }
  .mode-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .mode-choice { padding: 18px; border: 1px solid #e8edf5; border-radius: 9px; }
  .mode-choice.selected { border-color: var(--blue); background: #f0f4ff; box-shadow: inset 0 0 0 1px var(--blue); }
  .mode-symbol { width: 29px; height: 29px; margin-bottom: 12px; color: var(--blue); }
  .mode-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-family: var(--font-display); font-size: 21px; font-weight: 650; }
  .selection-mark { display: block; flex: 0 0 13px; width: 13px; height: 13px; border: 1px solid var(--muted); border-radius: 50%; }
  .selected .selection-mark { border: 4px solid var(--blue); background: white; }
  .mode-description { display: block; margin-top: 6px; color: var(--muted); font-size: 13px; line-height: 1.4; }
  .permission-panel { padding: 21px; border: 1px solid #e7ecf5; border-radius: 12px; box-shadow: 0 3px 12px #09318d04; }
  .permission-copy strong, .permission-copy span { display: block; }
  .permission-copy strong { font-size: 18px; font-weight: 600; }
  .permission-copy span { margin-top: 7px; font-size: 13px; color: var(--muted); }
  .permission-preview { margin: 8px 0; padding: 8px 10px; border: 1px solid var(--border); border-radius: 4px; background: var(--surface); color: var(--muted); font-family: var(--font-display); font-size: 14px; }
  .permission-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px; }
  .permission-actions .control-shape { min-width: 100px; padding: 9px 16px; }
  .quiet-control { border-color: var(--border); color: var(--blue); }
  .primary-control { border-color: var(--blue); background: var(--blue); color: white; }
  .pause-control { display: flex; align-items: center; gap: 14px; min-height: 76px; padding: 15px 18px; border-radius: 9px; background: #fff0f7; color: var(--pink-text); font-size: 17px; font-weight: 600; }
  .pause-control .icon { width: 38px; height: 38px; padding: 9px; border-radius: 50%; background: var(--pink-text); color: white; }
  .pause-control small { display: block; font-size: 11px; font-weight: 400; margin-top: 5px; }
  @container (max-width: 450px) {
    .wide-menu { display: none; }
    .head-body { gap: 14px; padding: 14px; }
    .head-stage { min-height: 214px; }
    .dwell-target { font-size: 17px; min-height: 58px; padding: 10px; gap: 8px; }
    .head-tools { gap: 10px; }
    .head-tool { gap: 8px; min-height: 53px; padding: 10px; font-size: 11px; }
    .head-tool .icon { width: 18px; height: 18px; }
    .tracking-chip { left: 10px; bottom: 10px; padding: 5px 8px; font-size: 9px; }
    .head-footer { padding: 14px; }
    .head-actions { gap: 16px; }
    .mode-choice { padding: 14px; }
    .control-bar { min-height: 56px; padding-inline: 18px; }
    .control-body { padding-inline: 18px; gap: 12px; }
    .permission-panel { padding: 16px; }
    .mode-description { font-size: 12px; }
  }
  @container (max-width: 360px) {
    .window-bar { padding-inline: 12px; }
    .app-name { display: none; }
    .editor-menu { gap: 16px; }
    .editor-ribbon { padding-inline: 12px; }
    .font-readout { gap: 5px; font-size: 10px; }
    .font-readout>span { gap: 6px; padding: 5px; }
    .font-readout .font-size { display: none; }
    .text-tools { gap: 10px; }
    .align-left { display: none; }
    .align-center { min-width: 88px; }
    .editor-canvas { padding-inline: 12px; }
    .document-page { padding: 14px 12px; }
    .document-heading { font-size: 17px; }
    .guide-footer { gap: 8px; padding-inline: 10px; }
    .head-body { gap: 10px; padding: 10px; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .head-stage { min-height: 190px; border-radius: 10px; }
    .dwell-visual { left: 37%; top: 40%; width: 55%; }
    .dwell-target { left: 10%; width: 72%; gap: 6px; font-size: 16px; padding: 8px; min-height: 52px; }
    .target-icon { width: 20px; height: 20px; }
    .head-tool { gap: 6px; min-height: 48px; padding: 8px; font-size: 10px; }
    .head-tool .icon { width: 16px; height: 16px; }
    .tracking-chip { left: 7px; bottom: 8px; padding: 4px 6px; font-size: 8px; }
    .head-footer { padding: 12px 10px; gap: 10px; }
    .dwell-instruction strong { font-size: 9px; }
    .dwell-instruction>span, .head-actions { font-size: 9px; }
    .head-actions { gap: 12px; }
    .control-body { padding-inline: 12px; }
    .mode-choices { gap: 8px; }
    .mode-choice { padding-inline: 10px; }
    .mode-description { max-width: 12ch; }
    .permission-panel { padding: 10px; }
    .permission-actions .control-shape { min-width: 0; flex: 1; }
    .mode-title { font-size: 19px; }
    .pause-control { padding: 12px; gap: 10px; }
  }
  @media (max-width: 767px) {
    .product-demo { border-radius: 14px; }
    .window-bar { min-height: 40px; padding: 9px 12px; border-radius: 13px 13px 0 0; }
    .window-controls { flex-basis: 58px; }
    .window-controls svg { width: 58px; height: 14px; }
    .document-icon { width: 19px; height: 19px; }
    .editor-menu { height: 30px; padding-inline: 12px; gap: 16px; font-size: 10px; }
    .editor-ribbon { gap: 10px; padding: 12px; }
    .format-tools { gap: 10px; }
    .font-readout { font-size: 10px; }
    .text-tools { gap: 10px; }
    .text-tools .icon { width: 16px; height: 16px; }
    .font-color { font-size: 17px; }
    .align-center { min-width: 78px; min-height: 64px; padding: 8px; font-size: 9px; }
    .align-center .icon { width: 24px; height: 24px; }
    .guide-callout { top: calc(100% + 9px); right: -4px; padding: 7px 10px; font-size: 11px; }
    .editor-canvas { padding: 24px 16px 0; }
    .document-page { min-height: 120px; padding: 16px; font-size: 10px; }
    .document-heading { font-size: 16px; }
    .document-rule { height: 5px; margin-top: 10px; }
    .guide-footer { min-height: 50px; gap: 8px; padding: 8px 10px; }
    .step-marker { flex-basis: 22px; width: 22px; height: 22px; font-size: 11px; }
    .step-copy strong { font-size: 11px; }
    .step-copy span { font-size: 9px; }
    .head .window-title { font-size: 12px; }
    .head-body { gap: 10px; padding: 10px; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .head-stage { min-height: clamp(164px, 55cqw, 200px); border-radius: 10px; }
    .dwell-target { top: 25%; left: 10%; width: 72%; min-height: 44px; padding: 8px; gap: 6px; font-size: 14px; }
    .target-icon { width: 19px; height: 19px; }
    .dwell-visual { top: 36%; left: 42%; width: 50%; }
    .head-tool { min-height: 44px; gap: 6px; padding: 8px; font-size: 10px; }
    .head-tool .icon { width: 16px; height: 16px; }
    .tracking-chip { left: 7px; bottom: 8px; padding: 4px 6px; font-size: 8px; }
    .head-footer { gap: 10px; padding: 12px 10px; }
    .dwell-instruction strong, .dwell-instruction>span, .head-actions { font-size: 9px; }
    .head-actions { gap: 12px; }
    .control-bar { min-height: 48px; padding-inline: 14px; }
    .kaji-logo { width: 70px; height: 28px; }
    .control-body { gap: 12px; padding: 0 14px 18px; }
    .mode-choice { padding: 12px; }
    .mode-symbol { width: 23px; height: 23px; margin-bottom: 8px; }
    .mode-title { font-size: 18px; }
    .mode-description { font-size: 10px; }
    .permission-panel { padding: 12px; }
    .permission-copy strong { font-size: 15px; }
    .permission-copy span { font-size: 11px; }
    .permission-preview { padding: 7px 8px; font-size: 11px; }
    .permission-actions { gap: 8px; margin-top: 12px; }
    .permission-actions .control-shape { min-width: 0; min-height: 34px; padding: 7px 12px; font-size: 11px; }
    .pause-control { min-height: 62px; gap: 10px; padding: 12px; font-size: 14px; }
    .pause-control .icon { width: 30px; height: 30px; padding: 7px; }
    .pause-control small { font-size: 9px; margin-top: 3px; }
  }
  @media (forced-colors: active) {
    .align-center, .mode-choice.selected, .dwell-target { outline: 2px solid Highlight; outline-offset: -3px; }
    .ring-track { stroke: GrayText; }
    .ring-progress { stroke: Highlight; }
    .selection-mark { border-color: ButtonText; }
    .selected .selection-mark { border-color: Highlight; }
  }
</style>
