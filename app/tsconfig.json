{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "WebWorker"],
    "types": ["bun"], "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "agent/**/*.ts"]
}
